<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- アドインの基本情報 -->
  <!-- ★ Id は https://www.guidgenerator.com/ で生成したGUIDに変更してください -->
  <Id>YOUR-GUID-HERE-0000-000000000000</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>管理部門</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="KANRI ASSIST"/>
  <Description DefaultValue="定型メール返信と入力ミス防止チェックを自動化します"/>
  <IconUrl DefaultValue="https://take5446.github.io/kanri-assist/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://take5446.github.io/kanri-assist/icon-64.png"/>
  <SupportUrl DefaultValue="https://take5446.github.io/kanri-assist/"/>

  <!-- Outlook専用設定 -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- 対応バージョン -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- 旧バージョン向けフォールバック -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <!-- ★ URLを自分のGitHub PagesのURLに変更してください -->
        <SourceLocation DefaultValue="https://take5446.github.io/kanri-assist/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- 権限設定 -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- 表示ルール（全メールで表示） -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <!-- 新バージョン向け設定 -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <!-- デスクトップ版Outlook -->
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>

          <!-- メール読み取り時のリボンボタン -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- メール作成時のリボンボタン -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId2</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>

      </Host>
    </Hosts>

    <!-- リソース定義 -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://take5446.github.io/kanri-assist/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://take5446.github.io/kanri-assist/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://take5446.github.io/kanri-assist/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <!-- ★ 3箇所のURLを自分のGitHub PagesのURLに変更してください -->
        <bt:Url id="Commands.Url" DefaultValue="https://take5446.github.io/kanri-assist/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://take5446.github.io/kanri-assist/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="KANRI ASSIST"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="KANRI ASSIST を開く"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="定型メール返信と入力チェックを自動化します"/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
